# PocketBase application backend
POCKETBASE_URL=http://127.0.0.1:8090
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Read-only source used by the local MongoDB -> PocketBase migrator
MONGODB_MIGRATION_URL=mongodb://localhost:27017/jalms
PB_MIGRATION_PASSWORD=

# Local-only seed passwords. Keep these empty in the committed example.
DEMO_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=
RESET_ADMIN_PASSWORD=
SIMULATION_PASSWORD=

# NextAuth JWT secret (keep local; never commit the real value)
AUTH_SECRET=
